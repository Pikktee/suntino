# Kopiere diese Datei nach .env und trage deinen OpenRouter-API-Key ein.
# Key erstellen: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: Modell umstellen (günstige, für Zusammenfassungen gut geeignete Modelle).
# Standard ist google/gemini-2.0-flash-001 — sehr günstig, großer Kontext, stark beim Verdichten.
# Alternativen:
#   google/gemini-flash-1.5-8b   (noch günstiger)
#   openai/gpt-4o-mini           (günstig, sehr solide)
#   meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: Port (Standard 3000)
# PORT=3000

# Optional: Dev-Auto-Reload der Extension abschalten (Standard: an).
# HOTRELOAD=0
