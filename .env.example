# Kopiere diese Datei nach .env und trage deinen OpenRouter-API-Key ein.
# Key erstellen: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: Modell umstellen (günstige, für Zusammenfassungen gut geeignete Modelle).
# Standard ist google/gemini-2.5-flash-lite — sehr günstig, großer Kontext, stark beim Verdichten.
# Alternativen:
#   openai/gpt-4o-mini           (günstig, sehr solide)
#   meta-llama/llama-3.3-70b-instruct
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional: eigene Modelle je Inhaltstyp.
# OPENROUTER_VIDEO_MODEL=google/gemini-2.5-flash
# OPENROUTER_PDF_MODEL=google/gemini-2.5-flash
# OPENROUTER_LONG_MODEL=google/gemini-2.5-pro

# Optional: Modell für "Leichte Sprache" (normale Texte). Standard google/gemini-2.5-flash.
# Für maximale Qualität bei den Grammatikregeln auf google/gemini-2.5-pro umstellen.
# OPENROUTER_PLAIN_MODEL=google/gemini-2.5-flash

# Optional: Port (Standard 3000)
# PORT=3000

# Optional: Dev-Auto-Reload der Extension abschalten (Standard: an).
# HOTRELOAD=0
